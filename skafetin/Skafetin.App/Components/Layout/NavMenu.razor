<MudNavMenu>
    <AuthorizeView>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                Prijava
            </MudNavLink>
        </NotAuthorized>

        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Početna
            </MudNavLink>

            <AuthorizeView Roles="Admin,AssetManager,LocationResponsible" Context="imovina">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4">IMOVINA</MudText>

                <MudNavLink Href="/equipment" Icon="@Icons.Material.Filled.Inventory2">
                    Oprema
                </MudNavLink>
                <MudNavLink Href="/assignments" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                    Zaduženja
                </MudNavLink>
                <MudNavLink Href="/inventories" Icon="@Icons.Material.Filled.FactCheck">
                    Inventure
                </MudNavLink>
            </AuthorizeView>

            <AuthorizeView Roles="Admin,AssetManager" Context="zahtjevi">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4">ZAHTJEVI</MudText>

                <MudNavLink Href="/equipment-requests" Icon="@Icons.Material.Filled.Mail">
                    Zahtjevi za opremom
                </MudNavLink>
                <MudNavLink Href="/write-off-requests" Icon="@Icons.Material.Filled.DeleteSweep">
                    Otpis
                </MudNavLink>
            </AuthorizeView>

            <AuthorizeView Roles="Admin,AssetManager" Context="sifrarnici">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="px-4">ŠIFRARNICI</MudText>

                <MudNavLink Href="/locations" Icon="@Icons.Material.Filled.Place">
                    Lokacije
                </MudNavLink>
                <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.Badge">
                    Zaposlenici
                </MudNavLink>
            </AuthorizeView>

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4">MOJE</MudText>

            <MudNavLink Href="/my-equipment" Icon="@Icons.Material.Filled.Laptop">
                Moja oprema
            </MudNavLink>
            <MudNavLink Href="/my-requests" Icon="@Icons.Material.Filled.Outbox">
                Moji zahtjevi
            </MudNavLink>

            <AuthorizeView Roles="Admin" Context="administracija">
                <MudDivider Class="my-2" />
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts">
                    Korisnici i uloge
                </MudNavLink>
            </AuthorizeView>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
