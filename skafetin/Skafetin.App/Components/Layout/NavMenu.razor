@using Skafetin.App.Services
@inject CurrentUserService CurrentUser
@implements IDisposable

<MudNavMenu>
    @if (!CurrentUser.IsLoggedIn)
    {
        <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
            Prijava
        </MudNavLink>
    }
    else
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            Početna
        </MudNavLink>

        @if (CurrentUser.HasAnyRole("Admin", "AssetManager", "LocationResponsible"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4">IMOVINA</MudText>

            <MudNavLink Href="/equipment" Icon="@Icons.Material.Filled.Inventory2">
                Oprema
            </MudNavLink>
            <MudNavLink Href="/assignments" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                Zaduženja
            </MudNavLink>
            <MudNavLink Href="/inventories" Icon="@Icons.Material.Filled.FactCheck">
                Inventure
            </MudNavLink>

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4">ZAHTJEVI</MudText>

            <MudNavLink Href="/equipment-requests" Icon="@Icons.Material.Filled.Mail" Disabled="true">
                Zahtjevi za opremom
            </MudNavLink>
            <MudNavLink Href="/write-off-requests" Icon="@Icons.Material.Filled.DeleteSweep">
                Otpis
            </MudNavLink>
        }

        @if (CurrentUser.HasAnyRole("Admin", "AssetManager"))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4">ŠIFRARNICI</MudText>

            <MudNavLink Href="/locations" Icon="@Icons.Material.Filled.Place">
                Lokacije
            </MudNavLink>
            <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.Badge">
                Zaposlenici
            </MudNavLink>
        }

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.caption" Class="px-4">MOJE</MudText>

        <MudNavLink Href="/my-equipment" Icon="@Icons.Material.Filled.Laptop">
            Moja oprema
        </MudNavLink>
        <MudNavLink Href="/my-requests" Icon="@Icons.Material.Filled.Outbox" Disabled="true">
            Moji zahtjevi
        </MudNavLink>


        @if (CurrentUser.HasRole("Admin"))
        {
            <MudDivider Class="my-2" />
            <MudNavLink Href="/users" Icon="@Icons.Material.Filled.ManageAccounts" Disabled="true">
                Korisnici i uloge
            </MudNavLink>
        }
    }
    
</MudNavMenu>


@code
{
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += HandleUserChanged;
    }

    private void HandleUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= HandleUserChanged;
    }
}

