@using Microsoft.AspNetCore.Components.Authorization
@using Skafetin.App.Services
@inject CurrentUserService currentUser
@inject NavigationManager Navigation
@implements IDisposable

@if (!currentUser.IsInitialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (currentUser.IsLoggedIn)
                    {
                        <Pages.Forbidden />
                    }
                    else
                    {
                        <div class="d-flex justify-center pa-8">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
}

@code
{
    private const string LoginPath = "login";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await currentUser.InitializeAsync();

        Navigation.LocationChanged += OnLocationChanged;

        RedirectIfNotLoggedIn();

        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(RedirectIfNotLoggedIn);

    private void RedirectIfNotLoggedIn()
    {
        if (currentUser.IsLoggedIn)
            return;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri);

        var cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0)
            path = path[..cut];

        if (string.Equals(path.Trim('/'), LoginPath, StringComparison.OrdinalIgnoreCase))
            return;

        Navigation.NavigateTo("/" + LoginPath);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
