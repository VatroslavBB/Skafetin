@using Skafetin.App.Services
@inject CurrentUserService currentUser
@inject NavigationManager Navigation
@implements IDisposable

@if (initializationFailed)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-8" Outlined="true" Elevation="0">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                <MudText Typo="Typo.h5">Aplikacija se nije uspjela pokrenuti</MudText>
            </div>

            <MudText Typo="Typo.body1" Class="mb-2">
                Podaci o prijavi nisu učitani u očekivanom vremenu.
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
                Pokušaj ponovo, a ako se ponavlja, osvježi stranicu ili se prijavi iznova.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="isInitializing"
                       OnClick="RetryInitializationAsync">
                Pokušaj ponovo
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (!currentUser.IsInitialized)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
}

@code
{
    private const string LoginPath = "login";
    private const string ForbiddenPath = "nema-pristupa";
    private static readonly TimeSpan InitializationTimeout = TimeSpan.FromSeconds(10);

    private static readonly Dictionary<string, string[]> RouteRoles = new(StringComparer.OrdinalIgnoreCase)
    {
        ["equipment"] = ["Admin", "InventoryManager", "LocationResponsible"],
        ["equipment/create"] = ["Admin", "InventoryManager"],
        ["equipment/edit"] = ["Admin", "InventoryManager"],

        ["assignments"] = ["Admin", "InventoryManager", "LocationResponsible"],
        ["assignments/create"] = ["Admin", "InventoryManager"],

        ["inventories"] = ["Admin", "InventoryManager", "LocationResponsible"],

        ["equipment-requests"] = ["Admin", "InventoryManager"],
        ["write-off-requests"] = ["Admin", "InventoryManager"],

        ["locations"] = ["Admin", "InventoryManager"],
        ["locations/create"] = ["Admin"],
        ["locations/edit"] = ["Admin"],
        ["employees"] = ["Admin", "InventoryManager"],
        ["employees/create"] = ["Admin"],
        ["employees/edit"] = ["Admin"],

        ["users"] = ["Admin"]
    };

    private bool isInitializing;
    private bool initializationFailed;
    private bool isSubscribed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await InitializeSessionAsync();
    }

    private async Task RetryInitializationAsync() => await InitializeSessionAsync();

    private async Task InitializeSessionAsync()
    {
        if (isInitializing)
            return;

        isInitializing = true;
        initializationFailed = false;
        StateHasChanged();

        try
        {
            await currentUser.InitializeAsync().WaitAsync(InitializationTimeout);
        }
        catch (Exception)
        {
            initializationFailed = true;
            return;
        }
        finally
        {
            isInitializing = false;
            StateHasChanged();
        }

        if (!isSubscribed)
        {
            Navigation.LocationChanged += OnLocationChanged;
            currentUser.UserChanged += OnUserChanged;
            currentUser.SessionExpiring += OnSessionExpiring;
            isSubscribed = true;
        }

        EnforceAccess();
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(EnforceAccess);

    private void OnSessionExpiring() =>
        InvokeAsync(currentUser.ExpireSession);

    private void OnUserChanged() =>
        InvokeAsync(() =>
        {
            EnforceAccess();
            StateHasChanged();
        });

    private void EnforceAccess()
    {
        var path = CurrentPath();

        if (!currentUser.IsLoggedIn)
        {
            if (!IsSamePath(path, LoginPath))
                Navigation.NavigateTo("/" + LoginPath);

            return;
        }

        var requiredRoles = FindRequiredRoles(path);

        if (requiredRoles is not null
            && !currentUser.HasAnyRole(requiredRoles)
            && !IsSamePath(path, ForbiddenPath))
        {
            Navigation.NavigateTo("/" + ForbiddenPath);
        }
    }

    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);

        var cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0)
            path = path[..cut];

        return path.Trim('/');
    }

    private static string[]? FindRequiredRoles(string path)
    {
        string[]? roles = null;
        var longest = -1;

        foreach (var rule in RouteRoles)
        {
            var isMatch = IsSamePath(path, rule.Key)
                || path.StartsWith(rule.Key + "/", StringComparison.OrdinalIgnoreCase);

            if (isMatch && rule.Key.Length > longest)
            {
                longest = rule.Key.Length;
                roles = rule.Value;
            }
        }

        return roles;
    }

    private static bool IsSamePath(string path, string route) =>
        string.Equals(path, route, StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        if (!isSubscribed)
            return;

        Navigation.LocationChanged -= OnLocationChanged;
        currentUser.UserChanged -= OnUserChanged;
        currentUser.SessionExpiring -= OnSessionExpiring;
    }
}
