<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.RuleFolder" Class="mr-2" />
            Obrada zahtjeva
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            @Request.Title<br />
            Podnositelj: @Request.RequestedByEmployeeFullName, @Request.CreatedAt.ToString("dd.MM.yyyy.")<br />
            Trenutni status: @Request.RequestStatusName
        </MudText>

        @if (AllowedStatuses.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Iz statusa "@Request.RequestStatusName" nema dopuštenog sljedećeg koraka.
            </MudAlert>
        }
        else
        {
            <MudSelect T="int?"
                       @bind-Value="newStatusId"
                       Label="Novi status"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                @foreach (var status in AllowedStatuses)
                {
                    <MudSelectItem T="int?" Value="@status.Id">@status.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string"
                          Label="Obrazloženje"
                          HelperText="Obavezno kod odbijanja zahtjeva."
                          @bind-Value="decisionNote"
                          Lines="3"
                          MaxLength="500"
                          Variant="Variant.Outlined" />
        }

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@validationMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="AllowedStatuses.Count == 0"
                   OnClick="Submit">
            Spremi odluku
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int RequestStatusRejected = 4;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public EquipmentRequestDto Request { get; set; } = default!;
    [Parameter, EditorRequired] public List<LookupDto> AllowedStatuses { get; set; } = new();

    private int? newStatusId;
    private string? decisionNote;
    private string? validationMessage;

    protected override void OnInitialized()
    {
        if (AllowedStatuses.Count == 1)
            newStatusId = AllowedStatuses[0].Id;
    }

    // Uvjetna obaveznost obrazloženja ne može se izraziti atributom na DTO-u,
    // pa se provjerava ovdje i neovisno u kontroleru.
    private void Submit()
    {
        if (newStatusId is null)
        {
            validationMessage = "Odaberite novi status.";
            return;
        }

        if (newStatusId == RequestStatusRejected && string.IsNullOrWhiteSpace(decisionNote))
        {
            validationMessage = "Kod odbijanja zahtjeva obrazloženje je obavezno.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ProcessRequestDto
        {
            NewStatusId = newStatusId.Value,
            DecisionNote = string.IsNullOrWhiteSpace(decisionNote) ? null : decisionNote.Trim()
        }));
    }

    private void Cancel() => MudDialog.Cancel();
}
