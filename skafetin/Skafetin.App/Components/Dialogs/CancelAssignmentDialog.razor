<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" />
            Storniranje zaduženja
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            @Assignment.InventoryNumber - @Assignment.EquipmentName<br />
            Zaduženo: @Assignment.EmployeeFullName, @Assignment.AssignedAt.ToString("dd.MM.yyyy.")
        </MudText>

        <EditForm Model="model">
            <DataAnnotationsValidator />
            <MudTextField Label="Razlog storniranja"
                          @bind-Value="model.Reason"
                          For="@(() => model.Reason)"
                          Lines="3"
                          Variant="Variant.Outlined" />
        </EditForm>

        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-3">
            Zapis se ne briše. Ostaje u povijesti sa statusom Stornirano.
        </MudAlert>

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@validationMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Submit">Storniraj</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AssignmentDto Assignment { get; set; } = default!;

    private CancelAssignmentDto model = new();
    private string? validationMessage;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(model.Reason))
        {
            validationMessage = "Razlog je obavezan.";
            return;
        }

        model.Reason = model.Reason.Trim();
        MudDialog.Close(DialogResult.Ok(model));
    }

    private void Cancel() => MudDialog.Cancel();
}
