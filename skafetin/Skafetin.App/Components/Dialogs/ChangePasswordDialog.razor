<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-2" />
            Promjena lozinke
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Račun: @Username
        </MudText>

        <MudTextField T="string"
                      Label="Nova lozinka"
                      @bind-Value="newPassword"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Potvrda lozinke"
                      @bind-Value="confirmPassword"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" />

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@validationMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Postavi lozinku</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string Username { get; set; } = string.Empty;

    private string? newPassword;
    private string? confirmPassword;
    private string? validationMessage;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            validationMessage = "Lozinka mora imati barem 8 znakova.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            validationMessage = "Lozinke se ne podudaraju.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ChangePasswordDto
        {
            NewPassword = newPassword,
            ConfirmPassword = confirmPassword ?? string.Empty
        }));
    }

    private void Cancel() => MudDialog.Cancel();
}
