@page "/equipment/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin,AssetManager")]
@rendermode InteractiveServer
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Uređivanje opreme</PageTitle>

<PageHeader Title="Uređivanje opreme" Subtitle="@subtitle" />

<LoadingArea IsLoading="isLoading" ErrorMessage="@errorMessage">
    <MudPaper Class="pa-6" Elevation="0" Style="max-width: 860px;">
        <EditForm Model="model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudTextField Label="Inventurni broj"
                                  @bind-Value="model.InventoryNumber"
                                  For="@(() => model.InventoryNumber)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField Label="Naziv"
                                  @bind-Value="model.Name"
                                  For="@(() => model.Name)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Proizvođač"
                                  @bind-Value="model.Manufacturer"
                                  For="@(() => model.Manufacturer)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Model"
                                  @bind-Value="model.Model"
                                  For="@(() => model.Model)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int"
                               Label="Kategorija"
                               @bind-Value="model.EquipmentCategoryId"
                               For="@(() => model.EquipmentCategoryId)"
                               Variant="Variant.Outlined">
                        @foreach (var category in categories)
                        {
                            <MudSelectItem T="int" Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int"
                               Label="Status"
                               @bind-Value="model.EquipmentStatusId"
                               For="@(() => model.EquipmentStatusId)"
                               Variant="Variant.Outlined">
                        @foreach (var status in statuses)
                        {
                            <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int"
                               Label="Lokacija"
                               @bind-Value="model.LocationId"
                               For="@(() => model.LocationId)"
                               Variant="Variant.Outlined">
                        @foreach (var location in locations)
                        {
                            <MudSelectItem T="int" Value="@location.Id">@location.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?"
                                     Label="Nabavna vrijednost (EUR)"
                                     @bind-Value="model.PurchaseValue"
                                     For="@(() => model.PurchaseValue)"
                                     Min="0"
                                     Format="0.00"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Opis"
                                  @bind-Value="model.Description"
                                  For="@(() => model.Description)"
                                  Lines="3"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <div class="d-flex gap-2 mt-6">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    Spremi promjene
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Disabled="isSaving"
                           OnClick="@(() => Navigation.NavigateTo($"/equipment/{Id}"))">
                    Odustani
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</LoadingArea>

@code {
    [Parameter] public int Id { get; set; }

    private SaveEquipmentDto model = new();

    private List<LookupDto> categories = new();
    private List<LookupDto> statuses = new();
    private List<LookupDto> locations = new();

    private string? subtitle;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var categoryResult = await Api.GetAsync<List<LookupDto>>("api/equipmentcategories");
        if (categoryResult.IsSuccess)
            categories = categoryResult.Data ?? new List<LookupDto>();

        var statusResult = await Api.GetAsync<List<LookupDto>>("api/equipmentstatuses");
        if (statusResult.IsSuccess)
            statuses = statusResult.Data ?? new List<LookupDto>();

        var locationResult = await Api.GetAsync<List<LookupDto>>("api/locations/lookup");
        if (locationResult.IsSuccess)
            locations = locationResult.Data ?? new List<LookupDto>();

        var equipment = await Api.GetAsync<EquipmentDetailsDto>($"api/equipment/{Id}");

        if (!equipment.IsSuccess || equipment.Data is null)
        {
            errorMessage = equipment.ErrorMessage ?? "Oprema nije pronađena.";
            isLoading = false;
            return;
        }

        var data = equipment.Data;

        subtitle = $"{data.InventoryNumber} - {data.Name}";

        // lokacija koja je u međuvremenu deaktivirana ne dolazi u lookupu
        if (!locations.Any(loc => loc.Id == data.LocationId))
            locations.Add(new LookupDto { Id = data.LocationId, Name = data.LocationName });

        model = new SaveEquipmentDto
        {
            InventoryNumber = data.InventoryNumber,
            Name = data.Name,
            Description = data.Description,
            Manufacturer = data.Manufacturer,
            Model = data.Model,
            EquipmentCategoryId = data.EquipmentCategoryId,
            EquipmentStatusId = data.EquipmentStatusId,
            LocationId = data.LocationId,
            PurchaseValue = data.PurchaseValue
        };

        isLoading = false;
    }

    private async Task SubmitAsync()
    {
        isSaving = true;

        var result = await Api.PutAsync<object>($"api/equipment/{Id}", model);

        if (result.IsSuccess)
        {
            Snackbar.Add("Promjene su spremljene.", Severity.Success);
            Navigation.NavigateTo($"/equipment/{Id}");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Spremanje nije uspjelo.", Severity.Error);
            isSaving = false;
        }
    }
}
