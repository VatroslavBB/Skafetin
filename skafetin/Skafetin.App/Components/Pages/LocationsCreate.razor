@page "/locations/create"
@rendermode InteractiveServer
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Nova lokacija</PageTitle>

<PageHeader Title="Nova lokacija" Subtitle="Unos nove lokacije" />

<LoadingArea IsLoading="isLoading" ErrorMessage="@errorMessage">
    <MudPaper Class="pa-6" Elevation="0" Style="max-width: 720px;">
        <EditForm Model="model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField Label="Naziv"
                                  @bind-Value="model.Name"
                                  For="@(() => model.Name)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Adresa"
                                  @bind-Value="model.Address"
                                  For="@(() => model.Address)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     Label="Poštanski broj"
                                     @bind-Value="model.Zip"
                                     For="@(() => model.Zip)"
                                     HideSpinButtons="true"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField Label="Grad"
                                  @bind-Value="model.City"
                                  For="@(() => model.City)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int"
                               Label="Vrsta lokacije"
                               @bind-Value="model.LocationTypeId"
                               For="@(() => model.LocationTypeId)"
                               Variant="Variant.Outlined">
                        @foreach (var type in locationTypes)
                        {
                            <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="model.IsActive" Color="Color.Primary">Aktivna</MudSwitch>
                </MudItem>
            </MudGrid>

            <div class="d-flex gap-2 mt-6">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    Spremi
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Disabled="isSaving"
                           OnClick="@(() => Navigation.NavigateTo("/locations"))">
                    Odustani
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</LoadingArea>

@code {
    private SaveLocationDto model = new();
    private List<LookupDto> locationTypes = new();

    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<LookupDto>>("api/locationtypes");

        if (result.IsSuccess)
            locationTypes = result.Data ?? new List<LookupDto>();
        else
            errorMessage = result.ErrorMessage;

        isLoading = false;
    }

    private async Task SubmitAsync()
    {
        isSaving = true;

        var result = await Api.PostAsync<LocationDto>("api/locations", model);

        if (result.IsSuccess)
        {
            Snackbar.Add("Lokacija je spremljena.", Severity.Success);
            Navigation.NavigateTo("/locations");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Spremanje nije uspjelo.", Severity.Error);
            isSaving = false;
        }
    }
}